set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR ARM64)
set(TOOLCHAIN "${CMAKE_CURRENT_LIST_DIR}/llvm-mingw-20260616-ucrt-ubuntu-22.04-x86_64")
set(CMAKE_C_COMPILER "${TOOLCHAIN}/bin/aarch64-w64-mingw32-clang")
set(CMAKE_CXX_COMPILER "${TOOLCHAIN}/bin/aarch64-w64-mingw32-clang++")
set(CMAKE_RC_COMPILER "${TOOLCHAIN}/bin/aarch64-w64-mingw32-windres")
set(CMAKE_AR "${TOOLCHAIN}/bin/llvm-ar")
set(CMAKE_RANLIB "${TOOLCHAIN}/bin/llvm-ranlib")
set(CMAKE_FIND_ROOT_PATH "${CMAKE_CURRENT_LIST_DIR}/prefix" "${TOOLCHAIN}/aarch64-w64-mingw32")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_EXE_LINKER_FLAGS_INIT "-static -Wl,--no-insert-timestamp")
set(PKG_CONFIG_EXECUTABLE "/bin/false" CACHE FILEPATH "" FORCE)
